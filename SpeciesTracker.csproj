<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- The tests/ tree hosts the standalone SpeciesTracker.Tests project; keep its sources
         (incl. generated AssemblyInfo under tests/**/obj) out of the mod assembly. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
    <!-- 0.3.0: animal scan performance - shared SpatialHashGrid over AnimalsManager (wrap-aware,
         rebuilt every 5s), animal marker move threshold (2m), so 500m tracking no longer scans
         the whole animal list per user per tick. -->
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Eco.ReferenceAssemblies" Version="0.14.2.1-beta-release-1106" />
    <PackageReference Include="Fody" Version="6.8.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="StrangeLoopGames.PropertyChanged.Fody" Version="3.4.2-slg.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Allows the SpeciesTracker.Tests project to unit-test TrackerPerf without Eco running. -->
    <InternalsVisibleTo Include="SpeciesTracker.Tests" />
  </ItemGroup>

</Project>
